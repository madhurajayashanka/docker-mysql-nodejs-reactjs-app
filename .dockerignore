# Dependencies (Crucial: prevents overwriting container-built modules with local ones)
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# Build Outputs (Ignore local builds; let Docker handle the production build)
build/
dist/
.next/
out/

# Docker Files (Docker does not need to copy its own instructions into the container)
Dockerfile
Dockerfile*
docker-compose*
.dockerignore

# Environment Secrets and Configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
**.env
**/.env

# Version Control and Metadata
.git
.gitignore
.gitattributes
.hg
.svn

# IDEs, Editors, and OS System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
